# ---------------------------------------------------------------------------
# FRONTEND env. Copy to frontend/.env.
# Vite exposes every VITE_* variable to the browser - never put a secret here.
# ---------------------------------------------------------------------------

# Local testing (what you want now):
VITE_API_BASE=http://127.0.0.1:8000

# Leave EMPTY instead to route through the vite dev proxy in vite.config.js
# (also works locally, and avoids CORS entirely).
# Deployed: VITE_API_BASE=https://your-api.onrender.com

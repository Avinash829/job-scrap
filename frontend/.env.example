# ---------------------------------------------------------------------------
# FRONTEND env. Copy to frontend/.env for local dev.
# Vite inlines every VITE_* var into the built JS at BUILD time, so:
#   - everything here is public by construction - never put a secret in it
#   - changing it in Vercel requires a REDEPLOY, not just a restart
# ---------------------------------------------------------------------------

# Local dev against a local backend:
VITE_API_BASE=http://127.0.0.1:8000

# Leave EMPTY instead to route through the vite dev proxy (vite.config.js),
# which avoids CORS entirely in local dev.

# Production (set in the Vercel dashboard, Production + Preview scopes):
#   VITE_API_BASE=https://jobscrap-api.onrender.com

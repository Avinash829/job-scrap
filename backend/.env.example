# ---------------------------------------------------------------------------
# BACKEND env. Copy to backend/.env and fill in. Never committed.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local dev: SQLite, zero setup. Path is relative to backend/.
# Neon: paste the POOLED connection string, psycopg driver:
#   postgresql+psycopg://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=sqlite:///./jobscrap.db

# --- Gemini ---------------------------------------------------------------
# Free keys: https://aistudio.google.com/apikey
# Comma-separated. NO quotes, NO spaces around the commas:
#   GEMINI_API_KEYS=AIzaSyAAA...,AIzaSyBBB...,AIzaSyCCC...
# Multiple keys give failover on 429s - not extra quota.
GEMINI_API_KEYS=

# Don't hand-pick this. Run `python -m scripts.probe_gemini` and use what it prints.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Telegram alerts (optional, later) ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- HTTP politeness ------------------------------------------------------
HTTP_TIMEOUT=30
MAX_CONCURRENCY=8
USER_AGENT=jobscrap/0.1 (personal job search tool)

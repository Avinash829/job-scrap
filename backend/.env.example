# ---------------------------------------------------------------------------
# BACKEND env. Copy to backend/.env for local dev.
# In PRODUCTION these are set in the Render dashboard / GitHub secrets -
# .env is never deployed.
# ---------------------------------------------------------------------------

# --- Database (REQUIRED in prod) ------------------------------------------
# Local: SQLite, zero setup, path relative to backend/.
DATABASE_URL=sqlite:///./jobscrap.db
#
# Production: Neon POOLED connection string with the psycopg driver. Note
# "+psycopg" - Neon's copy button gives you "postgresql://", which SQLAlchemy
# would try to open with psycopg2 and fail.
#   DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Gemini (needed only where ingest runs: locally + GitHub Actions) -----
# Free keys: https://aistudio.google.com/apikey
# Either style works:
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# ...or one CSV line instead:
# GEMINI_API_KEYS=key1,key2,key3

# Verify with: python -m scripts.probe_gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# --- API / CORS (prod only) -----------------------------------------------
# Your deployed frontend origin(s), comma-separated. No trailing slash.
# CORS_ORIGINS=https://jobscrap.vercel.app
# Matches Vercel's random preview hostnames; leave as-is.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Telegram alerts (optional) -------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- HTTP politeness ------------------------------------------------------
HTTP_TIMEOUT=30
MAX_CONCURRENCY=8
USER_AGENT=jobscrap/0.1 (personal job search tool)
